# קובץ זה הוא דוגמה ל-.env.local לפיתוח מקומי
# העתק קובץ זה ל-.env.local ועדכן את הערכים

# Turso Database - לפיתוח מקומי ניתן להשתמש ב-local SQLite
TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN לא נדרש עבור local SQLite

# או אם אתה רוצה להשתמש ב-Turso בענן גם בפיתוח:
# TURSO_DATABASE_URL=libsql://nadlan-bakfar-dev.turso.io
# TURSO_AUTH_TOKEN=your-dev-token-here

# Integration Key - ברירת מחדל
NEXT_PUBLIC_INTEGRATION_KEY=d22d8b05933905caee1f49348e556e7d43c0f38277b91258

# לאחר יצירת הקובץ, הרץ:
# npm run db:migrate  # ליצירת הטבלאות
# npm run db:seed     # לטעינת נתונים ראשוניים
