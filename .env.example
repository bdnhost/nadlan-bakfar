# Turso Database Configuration (REQUIRED)
# הגדרת מסד נתונים Turso - מחליף את Supabase

# כתובת מסד הנתונים של Turso
# קבל מ-Vercel Dashboard → Storage → Turso או מ-Turso CLI: turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# מפתח אימות של Turso
# קבל מ-Vercel Dashboard → Storage → Turso או מ-Turso CLI: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Integration Key Configuration (OPTIONAL)
# מפתח אינטגרציה (48 תווים הקסדצימליים)
# ברירת המחדל: d22d8b05933905caee1f49348e556e7d43c0f38277b91258
NEXT_PUBLIC_INTEGRATION_KEY=your-integration-key-here

# API URL Configuration (OPTIONAL)
# כתובת ה-API - ברירת המחדל תקבע אוטומטית לפי הסביבה
# לא צריך להגדיר אלא אם יש צורך לשנות את הכתובת
# API_URL=http://localhost:3000/api

# Vercel Configuration (AUTO-SET IN PRODUCTION)
# משתנה זה מוגדר אוטומטית על ידי Vercel
# NEXT_PUBLIC_VERCEL_URL=your-app.vercel.app

# הערות:
# 1. TURSO_DATABASE_URL ו-TURSO_AUTH_TOKEN הם חובה להפעלת המערכת
# 2. ניתן לקבל אותם מ-Vercel Dashboard או מ-Turso CLI
# 3. מפתח האינטגרציה ברירת המחדל יעבוד אם הרצת את db:seed
# 4. לפיתוח מקומי: הרץ npm run db:migrate ואז npm run db:seed
