# Supabase Configuration
# כתובת ה-API של Supabase (כולל הנתיב המלא לפונקציה)
API_URL=https://your-project.supabase.co/functions/v1/external-integration

# מפתח אינטגרציה (48 תווים הקסדצימליים)
NEXT_PUBLIC_INTEGRATION_KEY=your-integration-key-here

# הערות:
# 1. יש להחליף את 'your-project' בשם הפרויקט שלך ב-Supabase
# 2. כתובת ה-API הנוכחית (waatnnddbujgohmegmeu.supabase.co) לא נגישה - ודא שהכתובת נכונה
# 3. ניתן גם לעדכן את הכתובת והמפתח דרך ממשק הניהול: /admin/integration-key
